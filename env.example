# Copy this to .env and fill in real values there. Never commit .env or
# paste real secrets into chat/tickets - .env is already gitignored.

# ============================================================
# REQUIRED - nothing runs without these
# ============================================================

# Alpaca PAPER keys (from a paper trading account, not live) -
# app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Must be explicit - defaults to "dry" (parses alerts, logs what it would
# do, submits nothing) if unset. Only "paper" or "live" actually place
# orders; TRADE_MODE=live requires ALPACA_BASE_URL pointed at the live
# endpoint too, not just this flag.
TRADE_MODE=paper

# Patreon - needs a token from an account that's an active paid member of
# her Patreon tier that posts the alerts. Either provide a long-lived
# PATREON_ACCESS_TOKEN, or the three refresh-flow values so the bot can
# refresh it automatically when it expires:
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REFRESH_TOKEN=

# ============================================================
# Ticker whitelist - REVIEW THIS before turning paper on
# ============================================================
# Only tickers on this list are ever treated as tradeable symbols (this is
# the fix for the "PRINT/BIG/TODAY get traded as tickers" bug). The
# default below is a small placeholder set - her actual alerts have
# covered SPY, QQQ, AAPL, TSLA, NVDA, AMD, META, MU, MSTR, HOOD, ATAI, NVO,
# UNH and others. If a real ticker isn't on this list, that alert is
# silently skipped - expand this to match what she actually calls, or
# alerts you're expecting to see acted on won't be.
WHITELIST_TICKERS=AAPL,MSFT,AMD,NVDA,META,TSLA,SPY,QQQ,GOOGL,CRM,MSTR,MU,HOOD,ATAI,NVO,UNH

# ============================================================
# Discord - OPTIONAL. Leave all three unset to run Patreon-only.
# Read lavish_core/discord_ingest/listener.py's module docstring before
# setting these - this is a real ToS/account-risk decision, not a
# config toggle to flip casually.
# ============================================================
DISCORD_USER_TOKEN=
DISCORD_INGEST_ACCEPT_TOS_RISK=0
DISCORD_WATCH_CHANNEL_IDS=

# ============================================================
# Alerting - OPTIONAL but strongly recommended once paper is on.
# Without this, circuit-breaker trips, failed exit orders, and recovered
# crashed positions only show up in log files - nobody gets notified.
# Any Discord webhook URL works (Server Settings -> Integrations ->
# Webhooks -> New Webhook), doesn't need to be in her server at all.
# ============================================================
DISCORD_WEBHOOK_URL=

# ============================================================
# Everything below has a working default - only change if you want to
# tune it.
# ============================================================

# Position sizing (dollars per trade; PATRON_DOLLARS overrides
# DEFAULT_TRADE_DOLLARS for Patreon-sourced equity signals specifically)
DEFAULT_TRADE_DOLLARS=500
DEFAULT_OPTION_TRADE_DOLLARS=200
PATRON_DOLLARS=

# Equity bracket (only applied on the equity path - options trades use
# her stated target/stop directly, not these)
DEFAULT_STOP_LOSS_PCT=0.015
DEFAULT_TAKE_PROFIT_PCT=0.02

# Our own options exit guardrails - always active underneath her stated
# target/stop (when she gives one), and the entire exit plan when she
# doesn't. See lavish_core/trade/options_exit_monitor.py.
OPTIONS_OWN_STOP_LOSS_PCT=0.50
OPTIONS_OWN_TRAIL_TRIGGER_PCT=0.30
OPTIONS_OWN_TRAIL_DRAWDOWN_PCT=0.20
OPTIONS_EXPIRY_FORCE_CLOSE_MINUTES=30
OPTIONS_EXIT_MAX_MONITOR_HOURS=8
OPTIONS_EXIT_POLL_INTERVAL_SEC=5

# Crash recovery - how often to check for open positions with no active
# guardrail monitor in this process (e.g. after a restart)
RECONCILE_INTERVAL_SECONDS=120

# Circuit breaker
DAILY_LOSS_LIMIT_PCT=0.03
WEEKLY_LOSS_LIMIT_PCT=0.07
MAX_CONSECUTIVE_LOSSES=5

# Signal quality / matching
SIGNAL_CONFIDENCE_FLOOR=0.55
OPTION_STRIKE_TOLERANCE=5
SIGNAL_DEDUP_WINDOW_SECONDS=300

# Patreon polling cadence (seconds)
PATREON_POLL_SECONDS=20
VISION_AUTO=true

# Optional - HybridStore runs fine without Redis
REDIS_URL=

LOG_LEVEL=INFO
