# deploy/lavish-bot.service
# systemd unit for running the bot unattended (survives SSH disconnects,
# crashes, and reboots) - without this, "leave it running for a week" means
# babysitting a terminal session the whole time.
#
# Install (see DEPLOY.md for the full walkthrough):
#   sudo cp deploy/lavish-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lavish-bot
#
# Watch it:
#   systemctl status lavish-bot
#   journalctl -u lavish-bot -f
#
# First deploy with this file: `systemctl status lavish-bot` should reach
# "active (running)" within a few seconds, not sit in "activating" - that
# would mean the Type=notify READY=1 never arrived (check
# `journalctl -u lavish-bot` for why run_ingest.py didn't reach its
# startup-complete point). The sd_notify protocol itself is verified
# (tests/test_sd_notify.py, against a real socket) but real systemd
# Type=notify/WatchdogSec behavior can only be confirmed by watching an
# actual deploy - this is the one piece of this unit file that needs that
# real-environment confirmation.

[Unit]
Description=Lavish_bot - Patreon/Discord trade alert bot
After=network-online.target
Wants=network-online.target
# StartLimit* is a [Unit]-section directive, not [Service] - stops
# systemd from restart-looping forever if the problem is persistent
# (e.g. bad credentials): 5 crashes in 10 minutes and it gives up and
# reports the service as failed, which is the correct outcome to surface
# loudly rather than spin on forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# notify (not simple): run_ingest.py calls sd_notify READY=1 once startup
# actually finishes (reconciliation ran, every background thread is
# alive) and WATCHDOG=1 every 30s after that - see
# lavish_core/utils/sd_notify.py and WatchdogSec below. A silent hang (the
# process is alive but every loop is stuck) now gets caught and
# restarted; Type=simple only catches the process dying outright, not a
# live deadlock.
Type=notify
NotifyAccess=main
WatchdogSec=90

# Change these two to match where you actually deployed and which user
# should own the process - see DEPLOY.md. Running as a dedicated non-root
# user (not root) is the right call: this process only needs to read its
# own directory and make outbound HTTPS calls, nothing that needs root.
User=lavish
WorkingDirectory=/opt/lavish-bot

# Belt-and-suspenders with run_ingest.py's own load_dotenv() call - this
# makes the values visible to systemd itself too (e.g. `systemctl show`),
# useful when debugging a misconfigured deploy without needing to shell in.
EnvironmentFile=/opt/lavish-bot/.env

# Aborts the start (and gets caught by systemd as a failed start, visible
# in `systemctl status`) if credentials are missing, an import is broken,
# or tesseract isn't installed - instead of launching run_ingest.py into
# a state where it can't actually do anything.
ExecStartPre=/opt/lavish-bot/venv/bin/python /opt/lavish-bot/system_boot.py
ExecStart=/opt/lavish-bot/venv/bin/python /opt/lavish-bot/run_ingest.py

# Crash resilience - a Python exception that somehow escapes every
# try/except in the codebase (or an OOM kill, a segfault in a C
# extension, etc.) restarts the process instead of leaving the bot
# silently dead for the rest of the week.
Restart=on-failure
RestartSec=15

# journalctl -u lavish-bot captures this regardless, but a duplicate file
# copy is convenient for tailing/grepping without sudo.
StandardOutput=append:/opt/lavish-bot/logs/systemd.log
StandardError=append:/opt/lavish-bot/logs/systemd.log

# Sandboxing - this process only ever needs to read its own directory and
# make outbound HTTPS calls, nothing here costs it any real capability.
# ReadWritePaths is the one exception carved out of ProtectSystem=strict's
# otherwise-read-only filesystem: logs/, data/ (DuckDB file + its own temp
# dir), and vision/raw (downloaded Patreon images) all live under here.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lavish-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
